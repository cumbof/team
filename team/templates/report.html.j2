<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ team.name }} — team run report</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 960px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    line-height: 1.65;
    color: #24292f;
    background: #fff;
  }
  h1 { font-size: 1.8rem; margin-bottom: .25rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #d0d7de; padding-bottom: .3rem; }
  h3 { font-size: 1rem; margin: 0; }
  .goal {
    background: #f6f8fa;
    border-left: 4px solid #0969da;
    padding: .75rem 1rem;
    margin: 1rem 0 2rem;
    border-radius: 0 6px 6px 0;
    white-space: pre-wrap;
  }
  .members { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 2rem; }
  .member-card {
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: .6rem 1rem;
    min-width: 180px;
    background: #f6f8fa;
  }
  .member-card .handle { font-weight: 700; color: #0969da; }
  .member-card .role { font-size: .85rem; color: #57606a; }
  .member-card .model { font-size: .78rem; font-family: monospace; color: #57606a; margin-top: .2rem; }
  .workflow-meta { font-size: .9rem; color: #57606a; margin-bottom: 2rem; }
  .turn {
    border: 1px solid #d0d7de;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    overflow: hidden;
  }
  .turn-header {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    background: #f6f8fa;
    padding: .5rem 1rem;
    border-bottom: 1px solid #d0d7de;
  }
  .turn-index { font-size: .8rem; color: #57606a; }
  .turn-handle { font-weight: 700; color: #0969da; }
  .turn-role { font-size: .85rem; color: #57606a; }
  .turn-time { font-size: .78rem; color: #8c959f; margin-left: auto; }
  .turn-body { padding: .75rem 1rem; white-space: pre-wrap; word-break: break-word; }
  .files-written { font-size: .8rem; color: #57606a; padding: .4rem 1rem; background: #f6f8fa; border-top: 1px solid #d0d7de; }
  .files-written code { font-size: .85em; }
  .artifact { margin-bottom: 1.5rem; }
  .artifact-name {
    font-family: monospace;
    font-size: .9rem;
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px 6px 0 0;
    padding: .4rem .8rem;
    color: #24292f;
    border-bottom: none;
  }
  .artifact pre {
    margin: 0;
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 0 0 6px 6px;
    padding: .75rem 1rem;
    overflow-x: auto;
    font-size: .85rem;
    white-space: pre;
  }
  .no-data { color: #57606a; font-style: italic; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #d0d7de; font-size: .8rem; color: #8c959f; }
</style>
</head>
<body>

<h1>{{ team.name }}</h1>

<div class="goal">{{ team.goal | trim }}</div>

<h2>Members</h2>
<div class="members">
  {% for m in team.members %}
  <div class="member-card">
    <div class="handle">@{{ m.name }}</div>
    <div class="role">{{ m.role }}</div>
    <div class="model">{{ m.model }}</div>
  </div>
  {% endfor %}
</div>

<div class="workflow-meta">
  Workflow: <strong>{{ team.workflow.type }}</strong> &nbsp;·&nbsp;
  Max rounds: <strong>{{ team.workflow.max_rounds }}</strong>
</div>

<h2>Transcript</h2>

{% set member_turns = turns | selectattr("speaker", "ne", "orchestrator") | list %}
{% if member_turns %}
  {% for turn in member_turns %}
  <div class="turn">
    <div class="turn-header">
      <span class="turn-index">turn {{ turn.index }}</span>
      <span class="turn-handle">@{{ turn.speaker }}</span>
      <span class="turn-role">{{ turn.role }}</span>
      {% if turn.timestamp %}
      <span class="turn-time">{{ turn.timestamp | fmt_ts }}</span>
      {% endif %}
    </div>
    <div class="turn-body">{{ turn.content | trim }}</div>
    {% if turn.files_written %}
    <div class="files-written">
      wrote: {% for f in turn.files_written %}<code>{{ f }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
{% else %}
  <p class="no-data">No turns recorded yet.</p>
{% endif %}

<h2>Produced artifacts</h2>

{% if shared_files %}
  {% for path, content in shared_files.items() %}
  <div class="artifact">
    <div class="artifact-name">{{ path }}</div>
    <pre>{{ content | trim }}</pre>
  </div>
  {% endfor %}
{% else %}
  <p class="no-data">No files in the shared workspace.</p>
{% endif %}

<footer>
  Generated by <strong>team</strong> &nbsp;·&nbsp; workspace: {{ workspace }}
</footer>

</body>
</html>
